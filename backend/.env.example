# ============================================
# Dukaan Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---- Required ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=dukaan
JWT_SECRET=your-secret-key-change-this-in-production

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ---- Frontend URL (for email links) ----
FRONTEND_URL=http://localhost:3000

# ---- Email (Emergent Resend Integration) ----
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Dukaan
OWNER_NOTIFY_EMAIL=

# ---- Razorpay Payment Gateway ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Subscription Cron ----
SUBSCRIPTION_CRON_SECRET=

# ---- WhatsApp Integration (AuthKey.io) ----
AUTHKEY_API_KEY=
AUTHKEY_WHATSAPP_WID=47016

SERVERLESS_TOKEN_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
CORS_ORIGINS=https://officialdukaan.in
